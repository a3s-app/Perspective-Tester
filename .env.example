# Public identifiers; the project is hosted by Sanity.
NEXT_PUBLIC_SANITY_PROJECT_ID=j6m3ma08
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SITE_URL=https://www.perspectivetester.com
# Used only on the server; must match the Sanity webhook secret.
SANITY_REVALIDATE_SECRET=
# Draft preview: a Sanity Viewer token and a long random secret for preview links.
SANITY_VIEWER_TOKEN=
SANITY_PREVIEW_SECRET=
# Contact form (all server-only). Each enquiry is emailed through Resend and,
# if SLACK_WEBHOOK_URL is set, posted to Slack.
RESEND_API_KEY=
# An address on a domain verified in Resend, e.g. "Perspective Tester <forms@updates.p15r.com>".
RESEND_FROM_EMAIL=
# Who receives enquiries; comma-separated for several. Defaults to Info@perspectivetester.com.
CONTACT_FORM_TO=
# Slack incoming webhook. Never prefix with NEXT_PUBLIC_, which would publish it.
SLACK_WEBHOOK_URL=
